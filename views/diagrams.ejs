<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis diagramas — Diagramador</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="library-page">
  <div class="library">
    <header class="library__header">
      <div>
        <div class="brand-mark">
          <span class="brand-mark__name">Diagramador</span>
          <span class="brand-mark__tag">UML</span>
        </div>
        <h1>Mis diagramas</h1>
      </div>
      <div class="library__user">
        <span><%= userName %></span>
        <a class="logout" href="/logout">Cerrar sesión</a>
      </div>
    </header>

    <section class="panel" aria-labelledby="createTitle">
      <h2 class="panel__title" id="createTitle">Nueva sala</h2>
      <form class="form-row" action="/diagrams" method="POST">
        <input type="text" name="name" placeholder="Nombre del diagrama" maxlength="120" required>
        <button class="btn btn--primary" type="submit">Crear sala</button>
      </form>
    </section>

    <section class="panel" aria-labelledby="importTitle">
      <h2 class="panel__title" id="importTitle">Importar XMI</h2>
      <form class="form-row" action="/diagrams/import" method="POST" enctype="multipart/form-data">
        <input type="file" name="xmiFile" accept=".xmi,.xml" required>
        <button class="btn btn--accent" type="submit">Importar</button>
      </form>
    </section>

    <% if (diagrams.length === 0) { %>
      <div class="empty-state">
        <strong>Todavía no hay diagramas</strong>
        Crea una sala arriba o importa un archivo XMI para empezar.
      </div>
    <% } else { %>
      <ul class="diagram-list">
        <% diagrams.forEach(function(d) { %>
          <li class="diagram-item">
            <div>
              <div class="diagram-item__name"><%= d.name %></div>
              <div class="diagram-item__meta">
                <%= d.is_owner ? 'Propietario' : 'Colaborador' %> · <%= new Date(d.updated_at).toLocaleString() %>
              </div>
            </div>
            <div class="diagram-item__actions">
              <input class="share-link" type="text" readonly value="/room/<%= d.share_token %>" onclick="this.select()" title="Enlace de la sala">
              <a class="btn btn--accent btn--sm" href="/room/<%= d.share_token %>">Entrar</a>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <div id="toastContainer"></div>
  <script src="/toast.js"></script>
  <script>
    (function () {
      var flash = <%- JSON.stringify(flash || null) %>;
      window.Toast.fromFlash(flash);

      document.querySelectorAll(".share-link").forEach(function (input) {
        if (!input.value.startsWith("http")) {
          input.value = window.location.origin + input.value.replace(/^\/?/, "/");
        }
      });
    })();
  </script>
</body>
</html>
