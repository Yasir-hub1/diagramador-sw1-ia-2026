<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= diagramName %> - Diagramador UML</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; font-family: Arial, sans-serif; }
    body { background-color: #f0f2f5; }

    .container { display: flex; height: 100vh; width: 97vw; margin: 0 auto; }

    .toolbar {
      display: flex;
      flex-direction: column;
      margin-right: 20px;
      width: 220px;
      padding-top: 10px;
      overflow-y: auto;
    }

    .toolbar h1 { font-size: 18px; margin-bottom: 15px; }
    .toolbar a.back { display: block; margin-bottom: 15px; font-size: 13px; color: #555; }

    .toolbar button {
      padding: 10px 15px;
      margin-bottom: 8px;
      background-color: #4CAF50;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 13px;
    }
    .toolbar button:hover { background-color: #45a049; }

    #diagram { flex-grow: 1; border: 1px solid #ccc; background: white; overflow: auto; }

    .panel {
      background: white;
      border-radius: 6px;
      padding: 10px;
      margin-top: 15px;
      font-size: 13px;
    }
    .panel h2 { font-size: 13px; margin-bottom: 8px; color: #333; }
    #presenceList { list-style: none; }
    #presenceList li { padding: 3px 0; }
    #presenceList li::before { content: "● "; color: #4CAF50; }

    #contextMenu {
      display: none;
      position: absolute;
      z-index: 1000;
      background-color: white;
      border: 1px solid #ccc;
      box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
    }
    #contextMenu ul { list-style: none; }
    #contextMenu ul li { padding: 10px 20px; cursor: pointer; }
    #contextMenu ul li:hover { background-color: #f0f0f0; }

    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.4);
      z-index: 2000;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.visible { display: flex; }
    .modal-box {
      background: white;
      border-radius: 8px;
      padding: 20px;
      width: 380px;
      max-height: 80vh;
      overflow-y: auto;
    }
    .modal-box h3 { margin-bottom: 12px; font-size: 16px; }
    .modal-box label { display: block; font-size: 12px; margin: 10px 0 4px; color: #444; }
    .modal-box input, .modal-box select, .modal-box textarea {
      width: 100%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 13px;
    }
    .modal-box .hint { font-size: 11px; color: #888; margin-top: 3px; }
    .modal-box .error { color: #c0392b; font-size: 12px; margin-top: 6px; min-height: 14px; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
    .modal-actions button {
      padding: 8px 16px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 13px;
    }
    .modal-actions .save { background: #4CAF50; color: white; }
    .modal-actions .cancel { background: #eee; color: #333; }

    .toolbar button.share { background-color: #2c7be5; }
    .toolbar button.share:hover { background-color: #1f63c4; }

    .share-row { display: flex; gap: 8px; margin-top: 4px; }
    .share-row input {
      flex-grow: 1;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 13px;
      background: #f7f7f7;
    }
    .share-row button {
      padding: 8px 14px;
      border: none;
      border-radius: 5px;
      background: #4CAF50;
      color: white;
      cursor: pointer;
      font-size: 13px;
      white-space: nowrap;
    }
    .share-hint { font-size: 12px; color: #666; margin-top: 10px; }
    .copy-feedback { font-size: 12px; color: #2c7be5; margin-top: 6px; min-height: 14px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="toolbar">
      <a class="back" href="/diagrams">&larr; Mis diagramas</a>
      <h1><%= diagramName %></h1>

      <button id="shareRoomBtn" class="share">🔗 Compartir sala</button>

      <button id="addUserClass">Agregar Clase</button>

      <button id="addAssociation">Asociación</button>
      <button id="addDependency">Dependencia</button>
      <button id="addAggregation">Agregación</button>
      <button id="addComposition">Composición</button>
      <button id="addInheritance">Herencia</button>
      <button id="addRealization">Realización</button>

      <div class="panel">
        <h2>Conectados</h2>
        <ul id="presenceList"></ul>
      </div>

      <div class="panel">
        <h2>Estado</h2>
        <div id="selectionInfo">Selecciona el tipo de relación y luego el origen y destino.</div>
      </div>
    </div>

    <div id="diagram"></div>
  </div>

  <!-- Menú contextual -->
  <div id="contextMenu">
    <ul>
      <li id="editName">Editar Nombre / Estereotipo</li>
      <li id="editAttributes">Editar Atributos</li>
      <li id="editMethods">Editar Métodos</li>
      <li id="deleteClass">Eliminar Clase</li>
    </ul>
  </div>

  <!-- Modal: Clase (nombre + estereotipo) -->
  <div class="modal-overlay" id="modalClass">
    <div class="modal-box">
      <h3>Clase</h3>
      <label>Nombre</label>
      <input type="text" id="classNameInput" placeholder="Ej: Usuario">
      <label>Estereotipo</label>
      <select id="classStereotypeInput">
        <option value="none">Ninguno</option>
        <option value="interface">&lt;&lt;interface&gt;&gt;</option>
        <option value="abstract">&lt;&lt;abstract&gt;&gt;</option>
      </select>
      <div class="error" id="classError"></div>
      <div class="modal-actions">
        <button class="cancel" data-close="modalClass">Cancelar</button>
        <button class="save" id="classSaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Atributos -->
  <div class="modal-overlay" id="modalAttributes">
    <div class="modal-box">
      <h3>Atributos</h3>
      <label>Uno por línea, formato UML: visibilidad nombre: tipo</label>
      <textarea id="attributesInput" rows="6" placeholder="+ nombre: string&#10;- edad: number"></textarea>
      <div class="hint">Visibilidad: + público, - privado, # protegido, ~ paquete</div>
      <div class="error" id="attributesError"></div>
      <div class="modal-actions">
        <button class="cancel" data-close="modalAttributes">Cancelar</button>
        <button class="save" id="attributesSaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Métodos -->
  <div class="modal-overlay" id="modalMethods">
    <div class="modal-box">
      <h3>Métodos</h3>
      <label>Uno por línea, formato UML: visibilidad nombre(params): tipoRetorno</label>
      <textarea id="methodsInput" rows="6" placeholder="+ guardar(id: number): void"></textarea>
      <div class="error" id="methodsError"></div>
      <div class="modal-actions">
        <button class="cancel" data-close="modalMethods">Cancelar</button>
        <button class="save" id="methodsSaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Compartir sala -->
  <div class="modal-overlay" id="modalShare">
    <div class="modal-box">
      <h3>Compartir sala</h3>
      <label>Enlace de la sala</label>
      <div class="share-row">
        <input type="text" id="shareLinkInput" readonly>
        <button id="copyShareLinkBtn">Copiar</button>
      </div>
      <div class="copy-feedback" id="shareCopyFeedback"></div>
      <div class="share-hint">
        Cualquier usuario registrado que abra este enlace entra a la sala y puede
        ver el diagrama, editarlo y crear clases/relaciones en tiempo real junto a los demás.
      </div>
      <div class="modal-actions">
        <button class="cancel" data-close="modalShare">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Multiplicidad de relación -->
  <div class="modal-overlay" id="modalMultiplicity">
    <div class="modal-box">
      <h3>Multiplicidad</h3>
      <label>Origen</label>
      <input type="text" id="sourceMultiplicityInput" placeholder="Ej: 1, 0..1, *, 0..*, 1..*">
      <label>Destino</label>
      <input type="text" id="targetMultiplicityInput" placeholder="Ej: 1, 0..1, *, 0..*, 1..*">
      <div class="error" id="multiplicityError"></div>
      <div class="modal-actions">
        <button class="cancel" data-close="modalMultiplicity">Cancelar</button>
        <button class="save" id="multiplicitySaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.21/lodash.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/backbone.js/1.4.0/backbone-min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jointjs/3.4.2/joint.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/uml-validators.js"></script>
  <script>
    window.ROOM = {
      shareToken: <%- JSON.stringify(shareToken) %>,
      userName: <%- JSON.stringify(userName) %>,
      initialGraph: <%- JSON.stringify(graphData) %>
    };
  </script>
  <script src="/room.js"></script>
</body>
</html>
