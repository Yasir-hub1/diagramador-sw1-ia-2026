<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#1b4332">
  <title><%= diagramName %> — TRAZO</title>
  <link rel="stylesheet" href="/css/room.css">
</head>
<body class="room-page">
  <div class="room-shell">
    <header class="room-topbar">
      <button type="button" class="icon-btn" id="toolbarToggle" aria-label="Abrir herramientas" aria-expanded="false" aria-controls="roomToolbar">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div class="room-topbar__title"><%= diagramName %></div>
      <button type="button" class="icon-btn" id="shareRoomBtnMobile" aria-label="Compartir sala" title="Compartir">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8 10h4M7.2 7.2 4.5 6M7.2 12.8 4.5 14M12.8 7.2 15.5 6M12.8 12.8 15.5 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="4.5" cy="10" r="1.6" fill="currentColor"/><circle cx="15.5" cy="6" r="1.6" fill="currentColor"/><circle cx="15.5" cy="14" r="1.6" fill="currentColor"/></svg>
      </button>
    </header>

    <div class="toolbar-backdrop" id="toolbarBackdrop" hidden></div>

    <aside class="toolbar" id="roomToolbar">
      <a class="toolbar__back" href="/diagrams">Salas</a>
      <p class="toolbar__kicker">«sala»</p>
      <h1 class="toolbar__title"><%= diagramName %></h1>

      <div id="connectionStatus"><span class="dot"></span><span id="connectionStatusText">Conectando…</span></div>

      <button type="button" id="shareRoomBtn" class="share">Invitar a la sala</button>
      <button type="button" id="aiAssistantBtn" class="ai">Pedirle a la IA</button>
      <a class="tool-link" href="/room/<%= shareToken %>/export.xmi">Descargar XMI</a>

      <div class="toolbar-section">
        <h2>Piezas</h2>
        <button type="button" id="addUserClass">Nueva clase</button>
      </div>

      <div class="toolbar-section">
        <h2>Vínculos</h2>
        <button type="button" id="addAssociation">Asociación</button>
        <button type="button" id="addDependency">Dependencia</button>
        <button type="button" id="addAggregation">Agregación</button>
        <button type="button" id="addComposition">Composición</button>
        <button type="button" id="addInheritance">Herencia</button>
        <button type="button" id="addRealization">Realización</button>
      </div>

      <div class="side-panel">
        <h2>En la sala</h2>
        <ul id="presenceList"></ul>
      </div>

      <div class="side-panel">
        <h2>Qué sigue</h2>
        <div id="selectionInfo">Elige un vínculo y luego marca el origen y el destino.</div>
        <div id="saveStatus"></div>
      </div>
    </aside>

    <div class="canvas">
      <div id="diagram" role="application" aria-label="Lienzo del diagrama UML"></div>
    </div>
  </div>

  <div id="toastContainer" aria-live="polite"></div>

  <div id="contextMenu">
    <ul>
      <li id="editName">Editar nombre / estereotipo</li>
      <li id="editAttributes">Editar atributos</li>
      <li id="editMethods">Editar métodos</li>
      <li id="deleteClass">Eliminar clase</li>
    </ul>
  </div>

  <div class="modal-overlay" id="modalClass">
    <div class="modal-box" role="dialog" aria-labelledby="modalClassTitle">
      <h3 id="modalClassTitle">Nombre de la clase</h3>
      <label for="classNameInput">Nombre</label>
      <input type="text" id="classNameInput" placeholder="Ej: Usuario" autocomplete="off">
      <label for="classStereotypeInput">Estereotipo</label>
      <select id="classStereotypeInput">
        <option value="none">Ninguno</option>
        <option value="interface">&lt;&lt;interface&gt;&gt;</option>
        <option value="abstract">&lt;&lt;abstract&gt;&gt;</option>
      </select>
      <div class="error" id="classError"></div>
      <div class="modal-actions">
        <button type="button" class="cancel" data-close="modalClass">Cancelar</button>
        <button type="button" class="save" id="classSaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalAttributes">
    <div class="modal-box" role="dialog" aria-labelledby="modalAttrTitle">
      <h3 id="modalAttrTitle">Qué guarda la clase</h3>
      <label for="attributesInput">Uno por línea, formato UML: visibilidad nombre: tipo</label>
      <textarea id="attributesInput" rows="6" placeholder="+ nombre: string&#10;- edad: number"></textarea>
      <div class="hint">Visibilidad: + público, - privado, # protegido, ~ paquete</div>
      <div class="error" id="attributesError"></div>
      <div class="modal-actions">
        <button type="button" class="cancel" data-close="modalAttributes">Cancelar</button>
        <button type="button" class="save" id="attributesSaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalMethods">
    <div class="modal-box" role="dialog" aria-labelledby="modalMethodsTitle">
      <h3 id="modalMethodsTitle">Qué hace la clase</h3>
      <label for="methodsInput">Uno por línea, formato UML: visibilidad nombre(params): tipoRetorno</label>
      <textarea id="methodsInput" rows="6" placeholder="+ guardar(id: number): void"></textarea>
      <div class="error" id="methodsError"></div>
      <div class="modal-actions">
        <button type="button" class="cancel" data-close="modalMethods">Cancelar</button>
        <button type="button" class="save" id="methodsSaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalShare">
    <div class="modal-box" role="dialog" aria-labelledby="modalShareTitle">
      <h3 id="modalShareTitle">Invitar a la sala</h3>
      <label for="shareLinkInput">Enlace de la sala</label>
      <div class="share-row">
        <input type="text" id="shareLinkInput" readonly>
        <button type="button" id="copyShareLinkBtn">Copiar</button>
      </div>
      <div class="copy-feedback" id="shareCopyFeedback"></div>
      <div class="share-hint">
        Cualquier usuario registrado que abra este enlace entra a la sala y puede
        ver el diagrama, editarlo y crear clases o relaciones en tiempo real.
      </div>
      <div class="modal-actions">
        <button type="button" class="cancel" data-close="modalShare">Cerrar</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalAI">
    <div class="modal-box modal-ai" role="dialog" aria-modal="true" aria-labelledby="modalAiTitle" aria-describedby="aiHint">
      <h3 id="modalAiTitle">Pedir un cambio al diagrama</h3>
      <div id="aiChatLog" aria-live="polite"></div>
      <div id="aiAttachment" class="ai-attachment" hidden>
        <img id="aiAttachmentPreview" alt="Vista previa del diagrama adjunto">
        <div class="ai-attachment__meta">
          <p id="aiAttachmentName"></p>
          <p id="aiAttachmentSize"></p>
        </div>
        <button type="button" id="aiAttachmentRemove">Quitar</button>
      </div>
      <p id="aiStatus" class="ai-status" role="status" hidden></p>
      <section id="aiProposal" class="ai-proposal" aria-label="Propuesta de la IA" hidden>
        <p class="ai-proposal__kicker">Cambio propuesto</p>
        <p id="aiProposalMessage"></p>
        <p class="ai-proposal__kicker ai-proposal__kicker--ops">Cambios a aplicar</p>
        <ol id="aiProposalOps"></ol>
        <div id="aiProposalWarningBlock">
          <p class="ai-proposal__kicker">Para revisar</p>
          <ul id="aiProposalWarnings"></ul>
        </div>
        <div class="modal-actions">
          <button type="button" class="cancel" id="aiProposalCancel">Cancelar</button>
          <button type="button" class="save" id="aiProposalApply">Aplicar en la sala</button>
        </div>
      </section>
      <div class="ai-input-row">
        <label class="ai-file" id="aiImageLabel">
          <input type="file" id="aiImageInput" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8 9.2 12.2 5a2.4 2.4 0 0 1 3.4 3.4l-5.8 5.8a3.2 3.2 0 0 1-4.5-4.5l5.5-5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="visually-hidden">Adjuntar imagen</span>
        </label>
        <input type="text" id="aiTextInput" placeholder="Ej: Cliente realiza Pedido con varios Productos" autocomplete="off" aria-describedby="aiHint">
        <button type="button" id="aiMicBtn" title="Mantén presionado para dictar. La transcripción usa internet." aria-label="Grabar voz">
          <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="7" y="2.5" width="6" height="9" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4.5 9.5a5.5 5.5 0 0 0 11 0M10 15v2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
        <button type="button" id="aiSendBtn">Enviar</button>
      </div>
      <p class="ai-hint" id="aiHint"><% if (aiProvider === 'openai') { %>El arquitecto UML usa OpenAI. Propone un parche y espera a que lo apliques. Escribe, adjunta una imagen o dicta.<% } else { %>El arquitecto UML usa el modelo local. Propone un parche y espera a que lo apliques. Escribe o adjunta una imagen. El micrófono necesita una clave de OpenAI.<% } %></p>
      <div class="modal-actions">
        <button type="button" class="cancel" data-close="modalAI">Cerrar</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalMultiplicity">
    <div class="modal-box" role="dialog" aria-labelledby="modalMultTitle">
      <h3 id="modalMultTitle">Cuántos en cada extremo</h3>
      <label for="sourceMultiplicityInput">Origen</label>
      <input type="text" id="sourceMultiplicityInput" placeholder="Ej: 1, 0..1, *, 0..*, 1..*" autocomplete="off">
      <label for="targetMultiplicityInput">Destino</label>
      <input type="text" id="targetMultiplicityInput" placeholder="Ej: 1, 0..1, *, 0..*, 1..*" autocomplete="off">
      <div class="error" id="multiplicityError"></div>
      <div class="modal-actions">
        <button type="button" class="cancel" data-close="modalMultiplicity">Cancelar</button>
        <button type="button" class="save" id="multiplicitySaveBtn">Guardar</button>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.21/lodash.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/backbone.js/1.4.0/backbone-min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jointjs/3.4.2/joint.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/toast.js"></script>
  <script src="/uml-validators.js"></script>
  <script>
    window.ROOM = {
      shareToken: <%- JSON.stringify(shareToken) %>,
      userId: <%- JSON.stringify(userId) %>,
      userName: <%- JSON.stringify(userName) %>,
      initialGraph: <%- JSON.stringify(graphData) %>,
      aiMaxImageBytes: <%- JSON.stringify(aiMaxImageBytes) %>,
      aiProvider: <%- JSON.stringify(aiProvider) %>
    };
    window.Toast.fromFlash(<%- JSON.stringify(typeof flash !== 'undefined' ? flash : null) %>);
  </script>
  <script src="/room.js"></script>
  <script src="/diagram-snapshot.js"></script>
  <script src="/ai-assistant.js"></script>
</body>
</html>
